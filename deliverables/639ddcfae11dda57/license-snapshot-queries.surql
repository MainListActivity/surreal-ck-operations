INFO FOR NS;
USE NS main;
USE DB _system;
SELECT count() AS n FROM content_item GROUP ALL;
SELECT publication_status, count() AS n FROM content_item GROUP BY publication_status;
SELECT kind, publication_status, count() AS n FROM content_item GROUP BY kind, publication_status;
SELECT count() AS n FROM content_source_record GROUP ALL;
SELECT count() AS n FROM content_version GROUP ALL;
SELECT count() AS n FROM publication_event GROUP ALL;
SELECT event_kind, count() AS n FROM publication_event GROUP BY event_kind;
SELECT id, source_key, label, status, allowed_actions, created_at, updated_at FROM content_source ORDER BY source_key;
SELECT id, source, revision, license_kind, allowed_actions, effective_from, effective_until, evidence_url, evidence_text, created_by_subject, created_at FROM source_license_revision ORDER BY source, revision;
SELECT count() AS n FROM source_license_revision WHERE allowed_actions CONTAINSANY ["search","read","cite","export","browse","research","generate"] GROUP ALL;
SELECT count() AS n FROM source_license_revision WHERE effective_until != NONE GROUP ALL;
SELECT id, public_id, kind, publication_status, publication_revision, current_version FROM content_item WHERE public_id IN ["item_7f2161001cb94ad8868fcc02d089d44b","item_dfee35229a3949d485662e438c79eb99","item_8611b77897eb4198aed1870ed50161ff","item_fc41948315aa44489250eb75102f8a2f","item_63e576471cd346ffaff6a19de7647a78","item_1ed1d85fab7843b0a91a95f82d02a32c","item_0183b2e80b774190a858c8225511a3bd","item_f24ac023c8514e2b96f5feca7a868dc6","debug_publish_probe","item_052c480ddfdf4755921cbb26e045e7a2","item_06982d29e23b4d2a9db1a5c4b88842a6"];
SELECT id, public_id, item, revision, source, source_url, title, body_sha256, version_label, source_form FROM content_version WHERE public_id IN ["version_29b1f5f2b5904f6599aed917ac281133","version_383e8648f29143a89aa9747f5fc62a6e","version_000cfe210c26463cb6af5312c925ee7c","version_00143aeb0b654ffeb2dcac6fe05d300f","version_001afd656d164e72a2c8fce3664ead63","version_88bb608a246b4c4fa8ec6b3b8896c39e","version_b67c0e19e3c54e0fb8ca7a5e6a9555d3","version_545c21818b0e4bc19abac2c428cf2c6e","version_7b7492a29565490e8479c09d44eadf55"];
SELECT id, event_kind, item, version, occurred_at FROM publication_event WHERE event_kind != "published";
USE DB platform_content;
INFO FOR DB;
