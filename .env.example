# Copy to the service private directory as service.env (mode 0600).
# This file contains paths and service settings only; do not copy root secrets here.
SCK_PRODUCT_ENV=/absolute/path/to/existing/product/.env
SCK_MCP_PORT=38473
SCK_GITHUB_REPOSITORY=owner/repository
SCK_PROJECTOR_CREDENTIAL_FILE=/absolute/private/credentials/gm-01.token
SCK_PROJECTION_STATE_FILE=/absolute/private/gh-projection.json
