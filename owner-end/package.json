{
  "name": "company-owner-end",
  "private": true,
  "description": "老板端：Cloudflare 免费静态与同源转发，云端 Bun 业务与 LIVE 实时服务",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:ui": "bun --no-env-file scripts/build-ui.ts",
    "build": "bun run build:ui",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "dev": "bun run build && wrangler dev",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run --outdir dist",
    "demo": "bun --no-env-file demo/server.ts",
    "demo:export-script": "bun build ./demo/export.ts --target browser --format iife --outfile .demo/export.js",
    "start:backend": "bun --no-env-file src/server.ts",
    "cron:backend": "bun --no-env-file src/server-cron.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "buffer": "6.0.3",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "bun-types": "1.3.12",
    "typescript": "5.9.3",
    "wrangler": "^4.158.0"
  }
}
