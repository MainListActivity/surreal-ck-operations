-- Additive WT01 migration. No existing data rewritten or removed. No deletion policy.
DEFINE TABLE IF NOT EXISTS worktree SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS repo ON worktree TYPE string;
DEFINE FIELD IF NOT EXISTS project ON worktree TYPE option<string>;
DEFINE FIELD IF NOT EXISTS path ON worktree TYPE string;
DEFINE FIELD IF NOT EXISTS branch ON worktree TYPE option<string>;
DEFINE FIELD IF NOT EXISTS mode ON worktree TYPE string ASSERT $value IN ['shared', 'exclusive', 'protected'];
DEFINE FIELD IF NOT EXISTS protection ON worktree TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON worktree TYPE datetime;
DEFINE FIELD IF NOT EXISTS last_used_at ON worktree TYPE datetime;
DEFINE INDEX IF NOT EXISTS worktree_path ON worktree FIELDS path UNIQUE;
DEFINE INDEX IF NOT EXISTS worktree_repo ON worktree FIELDS repo;
DEFINE TABLE IF NOT EXISTS worktree_ref SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS task ON worktree_ref TYPE record<task>;
DEFINE FIELD IF NOT EXISTS tree ON worktree_ref TYPE record<worktree>;
DEFINE FIELD IF NOT EXISTS employee ON worktree_ref TYPE string;
DEFINE FIELD IF NOT EXISTS delivery ON worktree_ref TYPE string;
DEFINE FIELD IF NOT EXISTS fence ON worktree_ref TYPE int;
DEFINE FIELD IF NOT EXISTS intent ON worktree_ref TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS at ON worktree_ref TYPE datetime;
DEFINE INDEX IF NOT EXISTS worktree_ref_task ON worktree_ref FIELDS task UNIQUE;
DEFINE FIELD IF NOT EXISTS work_intent ON task TYPE option<object>;
DEFINE FIELD IF NOT EXISTS worktree ON task TYPE option<object>;
DEFINE FIELD IF NOT EXISTS workspace_repo ON employee TYPE option<string>;
DEFINE FIELD IF NOT EXISTS workspace_read_active ON employee TYPE option<bool>;
DEFINE TABLE IF NOT EXISTS worktree_session_ref SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS holder ON worktree_session_ref TYPE record<employee>;
DEFINE FIELD IF NOT EXISTS tree ON worktree_session_ref TYPE record<worktree>;
DEFINE FIELD IF NOT EXISTS employee ON worktree_session_ref TYPE string;
DEFINE FIELD IF NOT EXISTS delivery ON worktree_session_ref TYPE string;
DEFINE FIELD IF NOT EXISTS fence ON worktree_session_ref TYPE int;
DEFINE FIELD IF NOT EXISTS intent ON worktree_session_ref TYPE object FLEXIBLE;
DEFINE FIELD IF NOT EXISTS at ON worktree_session_ref TYPE datetime;
