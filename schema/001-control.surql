DEFINE TABLE IF NOT EXISTS company_meta SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS employee SCHEMALESS PERMISSIONS NONE;
DEFINE INDEX IF NOT EXISTS employee_credential_digest ON employee FIELDS credential_digest
  UNIQUE;
DEFINE TABLE IF NOT EXISTS task SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS audit SCHEMALESS PERMISSIONS NONE;
DEFINE TABLE IF NOT EXISTS idempotency SCHEMALESS PERMISSIONS NONE;
